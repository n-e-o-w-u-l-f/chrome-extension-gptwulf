# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/

# Test and tool caches
coverage/
.nyc_output/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Logs and local environment
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# Operating-system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# build/ is intentionally versioned as the loadable extension snapshot.
